NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/hostel.sqlite
# For Vercel Cloud Deployment, set your Turso / LibSQL credentials:
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
BACKUP_DIRECTORY=./backups
DEMO_OTP=false
# Local Mailpit SMTP defaults: SMTP receives mail on port 1025; its inbox UI is usually on port 8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Haven Hostel <no-reply@haven-hostel.test>
# For hosted OTP email, prefer an HTTPS email API (e.g. Resend); replace with a private provider key.
RESEND_API_KEY=
# `npm run setup` generates a unique local secret; never commit it.
AUTH_PEPPER=generate-a-random-32-byte-secret-with-npm-run-setup
BACKUP_ENCRYPTION_KEY=generate-a-random-secret-with-npm-run-setup
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
